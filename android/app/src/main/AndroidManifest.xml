<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WiFi bootstrap + TCP stream from the ESP32 SoftAP -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Foreground recording service (audio is NOT captured by the phone: dataSync type) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- In-app recording mode (CameraX); phone mic is used only to time-align the ESP32 audio -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".UmicApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Umic">

        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RecordExternalActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.HomeActivity" />

        <!-- Rotation must not recreate the activity: that would end the CameraX recording. -->
        <activity
            android:name=".ui.RecordInAppActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.HomeActivity" />

        <!-- Keep the running merge / picked inputs across rotation (no ViewModel in v1). -->
        <activity
            android:name=".ui.MergeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <service
            android:name=".service.AudioReceiverService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
