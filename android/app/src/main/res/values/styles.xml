<?xml version="1.0" encoding="utf-8"?>
<!-- Component styles: elevation 0 everywhere, hierarchy by surface tone + 1dp stroke. -->
<resources>
    <style name="Widget.Umic.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/umic_surface</item>
        <item name="strokeColor">@color/umic_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">@color/umic_ripple_amber</item>
    </style>
    <style name="Widget.Umic.Card.Mode">
        <item name="contentPadding">@dimen/card_padding</item>
    </style>
    <style name="ShapeAppearance.Umic.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Widget.Umic.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/umic_amber</item>
        <item name="android:textColor">@color/umic_on_amber</item>
        <item name="iconTint">@color/umic_on_amber</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="iconPadding">12dp</item>
    </style>
    <style name="Widget.Umic.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/umic_surface_high</item>
        <item name="android:textColor">@color/umic_text</item>
        <item name="iconTint">@color/umic_text</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Umic.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/umic_amber</item>
        <item name="iconTint">@color/umic_amber</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Umic.Chip.Status" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/umic_surface_high</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">@color/umic_text</item>
        <item name="android:textSize">13sp</item>
        <item name="chipIcon">@drawable/ic_dot</item>
        <item name="chipIconSize">10dp</item>
        <item name="chipIconTint">@color/umic_text_dim</item>
        <item name="chipIconVisible">true</item>
    </style>
    <style name="Widget.Umic.RecFab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="fabCustomSize">@dimen/rec_fab_size</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Umic.Circle</item>
        <item name="maxImageSize">40dp</item>
        <item name="backgroundTint">@color/umic_amber</item>
        <item name="tint">@color/umic_on_amber</item>
        <item name="elevation">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
    </style>
    <style name="Widget.Umic.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch" />
    <style name="Widget.Umic.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/umic_amber</item>
        <item name="trackColor">@color/umic_surface_high</item>
        <item name="trackCornerRadius">4dp</item>
        <item name="trackThickness">6dp</item>
    </style>
</resources>
