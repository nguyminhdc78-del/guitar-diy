<?xml version="1.0" encoding="utf-8"?>
<!-- Type scale. Timers use tabular digits so they do not jitter. -->
<resources>
    <style name="TextAppearance.Umic.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">56sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/umic_text</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.Umic.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/umic_text</item>
    </style>
    <style name="TextAppearance.Umic.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/umic_text</item>
    </style>
    <style name="TextAppearance.Umic.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/umic_text</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>
    <style name="TextAppearance.Umic.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/umic_text</item>
    </style>
    <style name="TextAppearance.Umic.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/umic_text_dim</item>
    </style>
    <style name="TextAppearance.Umic.Overline" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/umic_text_dim</item>
    </style>
    <style name="TextAppearance.Umic.Mono" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/umic_text</item>
    </style>
</resources>
