<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umic_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/umic_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/merge_title"
                android:textAppearance="@style/TextAppearance.Umic.Title" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Umic.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:cardBackgroundColor="#000000"
            app:strokeWidth="0dp">

            <VideoView
                android:id="@+id/videoPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 1: inputs -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Umic.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:contentPadding="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step_1"
                    android:textAppearance="@style/TextAppearance.Umic.Overline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickVideo"
                    style="@style/Widget.Umic.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/btn_pick_video"
                    app:icon="@drawable/ic_movie" />

                <TextView
                    android:id="@+id/textVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/label_no_video"
                    android:textAppearance="@style/TextAppearance.Umic.Caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textWav"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_no_wav"
                        android:textAppearance="@style/TextAppearance.Umic.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickWav"
                        style="@style/Widget.Umic.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_pick_wav" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2: sync status + preview -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Umic.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:contentPadding="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step_2"
                    android:textAppearance="@style/TextAppearance.Umic.Overline" />

                <TextView
                    android:id="@+id/textSync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:minHeight="24dp"
                    android:textAppearance="@style/TextAppearance.Umic.Body"
                    tools:text="✅ Đã khớp." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPreview"
                        style="@style/Widget.Umic.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="1"
                        android:text="@string/btn_preview"
                        app:icon="@drawable/ic_play_arrow" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAutoSync"
                        style="@style/Widget.Umic.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginStart="@dimen/space_s"
                        android:text="@string/btn_resync" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/label_fine_tune"
                    android:textAppearance="@style/TextAppearance.Umic.Caption" />

                <TextView
                    android:id="@+id/textOffset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Umic.Mono"
                    tools:text="Lệch: -14030 ms" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/row_earlier"
                    android:textAppearance="@style/TextAppearance.Umic.Label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNudgeM1000"
                        style="@style/Widget.Umic.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1"
                        android:text="@string/btn_step_1000" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNudgeM100"
                        style="@style/Widget.Umic.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:text="@string/btn_step_100" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNudgeM10"
                        style="@style/Widget.Umic.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:text="@string/btn_step_10" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/row_later"
                    android:textAppearance="@style/TextAppearance.Umic.Label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNudgeP10"
                        style="@style/Widget.Umic.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1"
                        android:text="@string/btn_step_10" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNudgeP100"
                        style="@style/Widget.Umic.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:text="@string/btn_step_100" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNudgeP1000"
                        style="@style/Widget.Umic.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:text="@string/btn_step_1000" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 3: merge -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Umic.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:contentPadding="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step_3"
                    android:textAppearance="@style/TextAppearance.Umic.Overline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMerge"
                    style="@style/Widget.Umic.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/btn_merge_start"
                    app:icon="@drawable/ic_merge" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressMerge"
                    style="@style/Widget.Umic.Progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:max="100"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.Umic.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenResult"
                    style="@style/Widget.Umic.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_open_result"
                    android:visibility="gone"
                    app:icon="@drawable/ic_play_arrow" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
